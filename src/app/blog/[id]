'use client';

import { useEffect, useState } from 'react';
import { useParams, notFound } from 'next/navigation';
import { createClientBrowser } from '@/lib/supabase/client';

export default function BlogDetailPage() {
  const params = useParams();
  const [blog, setBlog] = useState(null);
  const [loading, setLoading] = useState(true);
  const supabase = createClientBrowser();

  useEffect(() => {
    const fetchBlog = async () => {
      const { data } = await supabase
        .from('blogs')
        .select('*')
        .eq('id', params.id)
        .maybeSingle();
      setBlog(data);
      setLoading(false);
    };
    fetchBlog();
  }, [params.id, supabase]);

  // SEO মেটাডাটা সরাসরি ক্লায়েন্ট থেকে দেওয়া সম্ভব নয়, তবে layout.tsx-এ ডিফল্ট মেটাডাটা থাকবে।
  // আমরা এখানে document.title সেট করতে পারি
  useEffect(() => {
    if (blog) {
      document.title = `${blog.title} - কৃষিপথ ব্লগ`;
    }
  }, [blog]);

  if (loading) {
    return (
      <div className="container" style={{ padding: '2rem 0' }}>
        <div className="feature-card skeleton-card">
          <div className="skeleton" style={{ width: '80%', height: '2rem', marginBottom: '1rem' }}></div>
          <div className="skeleton" style={{ width: '60%', height: '1rem', marginBottom: '1rem' }}></div>
          <div className="skeleton" style={{ width: '100%', height: '10rem' }}></div>
        </div>
      </div>
    );
  }

  if (!blog || !blog.approved) {
    notFound();
    return null;
  }

  return (
    <div className="container" style={{ padding: '2rem 0' }}>
      <h2 className="section-title">{blog.title}</h2>
      <div className="feature-card" style={{ textAlign: 'left' }}>
        <small>{blog.category} — {blog.user_name}</small>
        <hr />
        <div style={{ whiteSpace: 'pre-wrap' }}>{blog.content}</div>
      </div>
    </div>
  );
}
