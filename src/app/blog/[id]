'use client';

import { useEffect, useState } from 'react';
import { useParams } from 'next/navigation';
import { createClientBrowser } from '@/lib/supabase/client';
import BlogCardSkeleton from '@/components/BlogCardSkeleton';

export default function BlogDetailPage() {
  const params = useParams();
  const [blog, setBlog] = useState(null);
  const [loading, setLoading] = useState(true);
  const supabase = createClientBrowser();

  useEffect(() => {
    const fetchBlog = async () => {
      const { data } = await supabase
        .from('blogs')
        .select('*')
        .eq('id', params.id)
        .maybeSingle();
      setBlog(data);
      setLoading(false);
      if (data?.approved) {
        document.title = `${data.title} - কৃষিপথ ব্লগ`;
      } else {
        document.title = 'ব্লগ পাওয়া যায়নি - কৃষিপথ';
      }
    };
    fetchBlog();
  }, [params.id, supabase]);

  if (loading) {
    return (
      <div className="container" style={{ padding: '2rem 0' }}>
        <BlogCardSkeleton />
        <BlogCardSkeleton />
      </div>
    );
  }

  if (!blog || !blog.approved) {
    return (
      <div className="container" style={{ padding: '3rem 0', textAlign: 'center' }}>
        <h2 style={{ color: 'var(--primary)' }}>❌ ব্লগ পাওয়া যায়নি</h2>
        <p>আপনি যে ব্লগটি খুঁজছেন, সেটি এখন আর উপলব্ধ নেই।</p>
        <a href="/blog" className="btn btn-primary" style={{ marginTop: '1rem' }}>
          সব ব্লগ দেখুন
        </a>
      </div>
    );
  }

  return (
    <div className="container" style={{ padding: '2rem 0' }}>
      <h2 className="section-title">{blog.title}</h2>
      <div className="feature-card" style={{ textAlign: 'left' }}>
        <small>{blog.category} — {blog.user_name}</small>
        <hr />
        <div style={{ whiteSpace: 'pre-wrap' }}>{blog.content}</div>
      </div>
    </div>
  );
}
