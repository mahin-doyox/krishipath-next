import { createClient } from '@/lib/supabase/server';
import { notFound } from 'next/navigation';

export default async function BlogDetailPage({ params }) {
  const supabase = await createClient();
  const { data: blog } = await supabase
    .from('blogs')
    .select('*')
    .eq('id', params.id)
    .maybeSingle();   // .single() না দিয়ে .maybeSingle() ব্যবহার করো

  if (!blog || !blog.approved) notFound();

  return (
    <div className="container" style={{ padding: '2rem 0' }}>
      <h2 className="section-title">{blog.title}</h2>
      <div className="feature-card" style={{ textAlign: 'left' }}>
        <small>{blog.category} — {blog.user_name}</small>
        <hr />
        <div style={{ whiteSpace: 'pre-wrap' }}>{blog.content}</div>
      </div>
    </div>
  );
}
